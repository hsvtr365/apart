# Mac 전용. .env.mac으로 복사해서 사용한다.
BOT_NAME=마을봇
ALLOWED_ROOM_IDS=18497328562223036
BOT_SENDER_ID=162909104
KAKAOCLI_BIN=/Users/suji/app/kakaoBot/vendor/kakaocli/.build/release/kakaocli
MAC_STATE_DIR=/Users/suji/app/kakaoBot/data/mac
GEMMA_BASE_URL=https://gitlab.swempire.co.kr/ollama/
GEMMA_MODEL=gemma4:26b
# 프로그램이 SSH 터널 28006 -> OCI 28004를 자동 관리한다.
APP_INTERNAL_URL=http://127.0.0.1:28006/api/internal/bot
APP_PUBLIC_URL=https://apart.jujeop.com
# 사이트의 APP_BOT_SECRET과 동일한 32자 이상 비밀값. Git/로그/채팅에 출력하지 않는다.
APP_BOT_SECRET=
